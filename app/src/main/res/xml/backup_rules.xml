<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Backups are off (android:allowBackup="false"); this excludes everything
     anyway, so a signed-in Firebase session or FCM token can never be restored onto another device. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
