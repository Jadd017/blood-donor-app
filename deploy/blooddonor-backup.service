# One database dump; started every night by blooddonor-backup.timer.
# Run one now: sudo systemctl start blooddonor-backup && journalctl -u blooddonor-backup -n 5
[Unit]
Description=BloodDonor database backup (pg_dump)
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/opt/blooddonor/bin/backup.sh
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/backups/blooddonor
