# Production settings for the BloodDonor server, read by systemd (blooddonor.service).
# Install as /etc/blooddonor/server.env, owned by blooddonor, mode 600. Never commit the real file.
# systemd format: KEY=value, no quotes needed, no spaces around "=".

# --- Network ---------------------------------------------------------------
# Listen on localhost only: Caddy on the same VM is the only way in.
HOST=127.0.0.1
PORT=8080
# Caddy connects from 127.0.0.1, so only its X-Forwarded-For is believed (per-IP rate limits).
TRUSTED_PROXY_IPS=127.0.0.1
# Open connections at most; more are closed at once.
# MAX_CONNECTIONS=500

# --- Database (roles created by deploy/db-setup.sql) ------------------------
DB_URL=jdbc:postgresql://127.0.0.1:5432/blooddonor
# The server itself: may only read and write rows.
DB_USER=blooddonor_runtime
DB_PASSWORD=<runtime-password>
# Owns the schema and runs the Flyway migrations at start-up.
DB_MIGRATION_USER=blooddonor_migrator
DB_MIGRATION_PASSWORD=<migrator-password>

# --- Firebase (Auth token checks and FCM push) --------------------------------
FIREBASE_PROJECT_ID=blooddonor-df959
# Service account key, owned by blooddonor, mode 600.
FIREBASE_CREDENTIALS_PATH=/etc/blooddonor/firebase-service-account.json

# --- Optional donor matching settings (defaults shown) ----------------------
# DONATION_GAP_DAYS_MALE=90
# DONATION_GAP_DAYS_FEMALE=120
# DONATION_GAP_DAYS_UNKNOWN_SEX=120
# WAVE_1_RADIUS_KM=15
# WAVE_2_AFTER_MINUTES=30
# WAVE_2_RADIUS_KM=30
# WAVE_3_AFTER_MINUTES=60
# WAVE_3_RADIUS_KM=60
# WAVE_4_AFTER_MINUTES=120
# MAX_DONORS_PER_WAVE=50
# MAX_NOTIFICATIONS_PER_24H=3
# JOB_INTERVAL_MINUTES=2
# ARRIVAL_WINDOW_MINUTES=180
# HELPER_BUFFER=1

# --- Optional anti-spam and safety settings (defaults shown) ----------------
# MAX_OPEN_REQUESTS=2
# MAX_OPEN_REQUESTS_NEW_ACCOUNT=1
# NEW_ACCOUNT_DAYS=7
# MAX_REQUESTS_PER_24H=3
# REPORTS_TO_HIDE=3
# FIRST_STRIKE_SUSPENSION_DAYS=7
# SECOND_STRIKE_SUSPENSION_DAYS=30
# SECOND_STRIKE_WINDOW_DAYS=90
# STRIKES_FOR_PERMANENT_SUSPENSION=3
# NO_SHOW_REQUESTERS_TO_PAUSE=3
# NO_SHOW_WINDOW_DAYS=90
# NO_SHOW_PAUSE_DAYS=30
# RATE_LIMIT_GENERAL_PER_MINUTE=120
# RATE_LIMIT_POST_REQUEST_PER_MINUTE=5
# RATE_LIMIT_HELP_PER_MINUTE=10
# RATE_LIMIT_REPORT_PER_MINUTE=5
# RATE_LIMIT_BLOCKS_PER_MINUTE=20
# RATE_LIMIT_PROFILE_PER_MINUTE=10
# RATE_LIMIT_DEVICE_TOKEN_PER_MINUTE=10
# RATE_LIMIT_WRITE_PER_MINUTE=30
