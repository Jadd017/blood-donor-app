# Copy this file to server/.env and fill in real values.
# server/.env is git-ignored; `./gradlew :server:run` loads it automatically.
DB_URL=jdbc:postgresql://localhost:5432/blooddonor
DB_USER=blooddonor_app
DB_PASSWORD=change-me

# Firebase Admin SDK. Keep the service account key OUTSIDE the repo.
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional, defaults to 8080
# PORT=8080

# Optional donor matching settings (defaults shown).
# DONATION_GAP_DAYS_MALE=90
# DONATION_GAP_DAYS_FEMALE=120
# DONATION_GAP_DAYS_UNKNOWN_SEX=120
# WAVE_1_RADIUS_KM=15
# WAVE_2_AFTER_MINUTES=30
# WAVE_2_RADIUS_KM=30
# WAVE_3_AFTER_MINUTES=60
# WAVE_3_RADIUS_KM=60
# WAVE_4_AFTER_MINUTES=120   (wave 4 reaches all of Lebanon)
# MAX_DONORS_PER_WAVE=50
# MAX_NOTIFICATIONS_PER_24H=3
# JOB_INTERVAL_MINUTES=2
# ARRIVAL_WINDOW_MINUTES=180   (a committed donor stops counting after this, or at the deadline)
# HELPER_BUFFER=1             (waves stop at units needed + this many helpers)

# Optional anti-spam and safety settings (defaults shown).
# MAX_OPEN_REQUESTS=2
# MAX_OPEN_REQUESTS_NEW_ACCOUNT=1   (for accounts younger than NEW_ACCOUNT_DAYS)
# NEW_ACCOUNT_DAYS=7
# MAX_REQUESTS_PER_24H=3
# REPORTS_TO_HIDE=3                  (reports from different users that hide a request and give a strike)
# FIRST_STRIKE_SUSPENSION_DAYS=7
# SECOND_STRIKE_SUSPENSION_DAYS=30   (when the 2nd strike comes within SECOND_STRIKE_WINDOW_DAYS)
# SECOND_STRIKE_WINDOW_DAYS=90
# STRIKES_FOR_PERMANENT_SUSPENSION=3
# NO_SHOW_REQUESTERS_TO_PAUSE=3      (no-shows from this many DIFFERENT requesters...)
# NO_SHOW_WINDOW_DAYS=90             (...within this many days...)
# NO_SHOW_PAUSE_DAYS=30              (...pause the donor's notifications this long)
# RATE_LIMIT_GENERAL_PER_MINUTE=120
# RATE_LIMIT_POST_REQUEST_PER_MINUTE=5
# RATE_LIMIT_HELP_PER_MINUTE=10
# RATE_LIMIT_REPORT_PER_MINUTE=5
# RATE_LIMIT_BLOCKS_PER_MINUTE=20
