# Copy this file to server/.env and fill in real values.
# server/.env is git-ignored; `./gradlew :server:run` loads it automatically.
DB_URL=jdbc:postgresql://localhost:5432/blooddonor
DB_USER=blooddonor_app
DB_PASSWORD=change-me

# Firebase Admin SDK. Keep the service account key OUTSIDE the repo.
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional, defaults to 8080
# PORT=8080

# Optional donor matching settings (defaults shown).
# DONATION_GAP_DAYS_MALE=90
# DONATION_GAP_DAYS_FEMALE=120
# DONATION_GAP_DAYS_UNKNOWN_SEX=120
# WAVE_1_RADIUS_KM=15
# WAVE_2_AFTER_MINUTES=30
# WAVE_2_RADIUS_KM=30
# WAVE_3_AFTER_MINUTES=60
# WAVE_3_RADIUS_KM=60
# WAVE_4_AFTER_MINUTES=120   (wave 4 reaches all of Lebanon)
# MAX_DONORS_PER_WAVE=50
# MAX_NOTIFICATIONS_PER_24H=3
# JOB_INTERVAL_MINUTES=2
# ARRIVAL_WINDOW_MINUTES=180   (a committed donor stops counting after this, or at the deadline)
# HELPER_BUFFER=1             (waves stop at units needed + this many helpers)
